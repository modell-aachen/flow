{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.13.6/.schema/devbox.schema.json",
  "packages": [
    "beamMinimal29Packages.elixir_1_20@1.20.2",
    "dexter@0.7.1",
    "beamMinimal29Packages.erlang@29.0.3",
    "beamMinimal29Packages.expert@0.1.6",
    "postgresql@18.4",
    "openspec@1.7.0"
  ],
  "env": {
    "MIX_ENV":                             "test",
    "MIX_OS_DEPS_COMPILE_PARTITION_COUNT": "5",
    "LOG_LEVEL":                           "warning",
    "PGPORT":                              "5544",
    "PGUSER":                              "postgres",
    "PGDATABASE":                          "postgres"
  },
  "shell": {
    "init_hook": [
      "git config core.hooksPath .githooks",
      "mkdir -p .nix-mix",
      "mkdir -p .nix-hex",
      "export MIX_HOME=$PWD/.nix-mix",
      "export HEX_HOME=$PWD/.nix-hex",
      "export ERL_AFLAGS='-kernel shell_history enabled'"
    ],
    "scripts": {
      "setup": [
        "mix local.hex --force",
        "mix local.rebar --force",
        "mix deps.get",
        "[ -f \"$PGDATA/PG_VERSION\" ] || initdb --username=$PGUSER --auth=trust --locale=C --encoding=UTF8 --set max_connections=200",
        "pg_isready --quiet || devbox services start postgresql",
        "timeout 30 bash -c 'until pg_isready --quiet; do sleep 0.5; done' || pg_isready"
      ],
      "ci": [
        "mix ci"
      ],
      "check": [
        "mix check"
      ],
      "test": [
        "mix test.interactive --max-cases 8 $@"
      ],
      "speedrun": [
        "mix speedrun"
      ],
      "consistency": [
        "mix consistency"
      ],
      "docs": [
        "MIX_ENV=dev mix compile",
        "MIX_ENV=dev mix docs --formatter html"
      ],
      "test.stop": [
        "devbox services stop postgresql"
      ]
    }
  }
}
